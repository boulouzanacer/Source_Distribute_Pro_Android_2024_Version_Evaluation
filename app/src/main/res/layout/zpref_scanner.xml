<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    android:visibility="gone"
    android:orientation="vertical"
    android:paddingHorizontal="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:text="@string/s_l_ctionnez_le_scanner_qui_vous_permetra_du_scanner_le_codebarre_qrcode" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_web_section_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp"
            android:text="@string/s_l_ctionner_scanner" />

        <RadioButton
            android:text="@string/int_grer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#0F172A"
            android:paddingVertical="8dp"
            android:id="@+id/radioScanner_integrer" />

        <RadioButton
            android:text="@string/camera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#0F172A"
            android:paddingVertical="8dp"
            android:id="@+id/radioScanner_camera" />

    </LinearLayout>

</LinearLayout>
