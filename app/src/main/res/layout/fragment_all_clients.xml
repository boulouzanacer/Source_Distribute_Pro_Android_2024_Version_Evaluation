<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="22dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="#F8FAFC"
    app:cardUseCompatPadding="true"
    app:strokeColor="#CBD5E1"
    app:strokeWidth="0.6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8FAFC"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="82dp"
            android:background="@drawable/bg_header_clients_pro"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sélection du client"
                    android:textSize="12sp"
                    android:textColor="#BFDBFE"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="3dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥 Clients"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif"
                    tools:ignore="HardcodedText"/>

            </LinearLayout>

            <Button
                android:id="@+id/add_client"
                android:text="Ajouter"
                android:textAllCaps="false"
                android:textColor="#0F4C81"
                android:textStyle="bold"
                android:textSize="12sp"
                app:icon="@drawable/ic_black_person_add_24"
                app:iconTint="#0F4C81"
                android:background="@drawable/bg_web_button_secondary"
                android:paddingStart="14dp"
                android:paddingEnd="18dp"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minHeight="44dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="0.7dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔍 Rechercher un client"
                        android:textColor="#0F4C81"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="7dp"
                        android:fontFamily="sans-serif-medium"/>

                    <LinearLayout
                        android:id="@+id/layout_header"
                        android:weightSum="10"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <EditText
                            android:id="@+id/search_field"
                            android:layout_width="0dp"
                            android:layout_weight="7.8"
                            android:layout_height="48dp"
                            android:minHeight="48dp"
                            android:ems="10"
                            android:hint="@string/rechercher_client"
                            android:textColorHint="#94A3B8"
                            android:textColor="#0F172A"
                            android:textSize="14.5sp"
                            android:inputType="text"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:background="@drawable/bg_web_section_card"
                            android:layout_marginEnd="6dp" />

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/scan"
                            android:layout_width="0dp"
                            android:layout_weight="1.1"
                            android:layout_height="48dp"
                            android:minHeight="48dp"
                            android:src="@drawable/ic_codebarre_scan"
                            android:scaleType="centerInside"
                            app:tint="#0F172A"
                            android:background="@drawable/bg_web_button_secondary"
                            android:contentDescription="@null"
                            android:layout_marginEnd="6dp"/>

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/cancel"
                            android:layout_width="0dp"
                            android:layout_weight="1.1"
                            android:layout_height="48dp"
                            android:minHeight="48dp"
                            android:src="@drawable/met_ic_clear"
                            android:scaleType="centerInside"
                            app:tint="#0F172A"
                            android:background="@drawable/bg_web_button_secondary"
                            android:contentDescription="@null"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="false"
                        android:weightSum="3">

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#EFF6FF"
                            app:strokeColor="#BFDBFE"
                            app:strokeWidth="0.7dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="8dp"
                                android:gravity="center">
                                <TextView android:id="@+id/badge_total_clients"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="#1D4ED8"
                                    android:textStyle="bold"
                                    android:textSize="16sp"
                                    android:fontFamily="sans-serif"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total"
                                    android:textColor="#1E40AF"
                                    android:textSize="11sp"
                                    android:layout_marginTop="1dp"
                                    android:fontFamily="sans-serif-medium"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="4dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FEF2F2"
                            app:strokeColor="#FECACA"
                            app:strokeWidth="0.7dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="8dp"
                                android:gravity="center">
                                <TextView android:id="@+id/badge_dette_clients"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="#B91C1C"
                                    android:textStyle="bold"
                                    android:textSize="16sp"
                                    android:fontFamily="sans-serif"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="En dette"
                                    android:textColor="#991B1B"
                                    android:textSize="11sp"
                                    android:layout_marginTop="1dp"
                                    android:fontFamily="sans-serif-medium"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="2dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#ECFDF5"
                            app:strokeColor="#A7F3D0"
                            app:strokeWidth="0.7dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="8dp"
                                android:gravity="center">
                                <TextView android:id="@+id/badge_credit_clients"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="#047857"
                                    android:textStyle="bold"
                                    android:textSize="16sp"
                                    android:fontFamily="sans-serif"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="À crédit"
                                    android:textColor="#065F46"
                                    android:textSize="11sp"
                                    android:layout_marginTop="1dp"
                                    android:fontFamily="sans-serif-medium"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="7dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📋 LISTE DES CLIENTS"
                    android:textColor="#334155"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView android:id="@+id/clients_count_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_clients_root"
                android:orientation="vertical">

                <ListView
                    android:id="@+id/list_client"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="7dp"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
