<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardUseCompatPadding="false"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="0.7dp"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/client_selector"
        android:baselineAligned="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <androidx.cardview.widget.CardView
            android:id="@+id/avatar_client_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#DBEAFE"
            app:strokeColor="#93C5FD"
            app:strokeWidth="0.7dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/avatar_initiales"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#1D4ED8"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                tools:text="SM"/>

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/nom_client"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Benali Mehdi SARL"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:baselineAligned="false"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Code: "
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:id="@+id/code_client"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#475569"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="000021 · 0555 12 34 56"/>

                <ImageView
                    android:id="@+id/img_client_location"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_baseline_wrong_location_24"
                    app:tint="#DC2626"
                    android:contentDescription="@null" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="end"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/sold_client"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="30dp"
                android:minWidth="40dp"
                android:background="@drawable/bg_pill_solde_zero"
                android:textColor="#92400E"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="11dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textStyle="bold"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:maxLines="1"
                tools:text="12,580.50" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
