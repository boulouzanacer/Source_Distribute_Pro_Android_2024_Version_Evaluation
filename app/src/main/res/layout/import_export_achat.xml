<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_web_section_card"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- LIGNE 1 TOP : Export achats Réseaux IP -->
        <RelativeLayout
            android:id="@+id/rlt_export_achats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:visibility="visible"
            android:onClick="onRelativeClick"
            android:background="@drawable/bg_import_row_top_selector"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_web_button_secondary"
                android:gravity="center">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Export achats"
                    android:src="@drawable/exportation_24" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="62dp"
                android:layout_marginEnd="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/exportt_achat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Exportation achats (Réseaux IP)"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Vous permet d'exporter les bons d'achats et les versements fournisseurs vers le serveur distant"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:lineSpacingExtra="1dp"
                    android:includeFontPadding="false"/>

            </LinearLayout>

        </RelativeLayout>

        <!-- LIGNE 2 MID : Export achats FTP (gone) -->
        <RelativeLayout
            android:id="@+id/rlt_export_achats_ftp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:visibility="gone"
            android:onClick="onRelativeClick"
            android:background="@drawable/bg_import_row_mid_selector"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="-0.8dp">

            <LinearLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_web_button_secondary"
                android:gravity="center">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Export achats FTP"
                    android:tint="#1F2937"
                    android:src="@drawable/ic_baseline_storage_24" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="62dp"
                android:layout_marginEnd="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/exportt_achat_ftp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Exportation achats (Serveur FTP)"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Vous permet d'exporter les bons d'achat vers le serveur FTP"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:lineSpacingExtra="1dp"
                    android:includeFontPadding="false"/>

            </LinearLayout>

        </RelativeLayout>

        <!-- LIGNE 3 MID : Achats exportés -->
        <RelativeLayout
            android:id="@+id/rlt_exported_achats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:visibility="visible"
            android:onClick="onRelativeClick"
            android:background="@drawable/bg_import_row_mid_selector"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="-0.8dp">

            <LinearLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_web_button_secondary"
                android:gravity="center">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Achats exportés"
                    android:src="@drawable/bon_exporte_24" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="62dp"
                android:layout_marginEnd="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/exportted_achat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bons d'achats exportés"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ça vous permet d'afficher les bons d'achats exportés avec la possibilité de suppression"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:lineSpacingExtra="1dp"
                    android:includeFontPadding="false"/>

            </LinearLayout>

        </RelativeLayout>

        <!-- LIGNE 4 BOTTOM : Etat achats (gone) -->
        <RelativeLayout
            android:id="@+id/rlt_etata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:visibility="gone"
            android:onClick="onRelativeClick"
            android:background="@drawable/bg_import_row_bottom_selector"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="-0.8dp">

            <LinearLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_web_button_primary"
                android:gravity="center">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="État achats"
                    android:src="@drawable/ic_baseline_info_24" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="62dp"
                android:layout_marginEnd="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/etat_a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Etat d'achats"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ça vous permet de consulter la quantité des produits achetés ansi que le montant total, remise total... entre deux date donné."
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:lineSpacingExtra="1dp"
                    android:includeFontPadding="false"/>

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

</LinearLayout>
