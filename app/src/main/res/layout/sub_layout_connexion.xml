<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/param_co"
    android:visibility="visible"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_web_section_card"
        android:padding="5dp"
        android:layout_marginBottom="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connexion base de données"
            android:textColor="#0F172A"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:includeFontPadding="false"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ip_text"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:contextClickable="false"
            android:hint="@string/adress_ip"
            app:errorMessage="@string/error_message_empty"
            app:errorType="empty"
            app:expandedHintEnabled="false"
            app:hintTextColor="@color/blue"
            app:boxStrokeWidth="1dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:startIconDrawable="@drawable/baseline_http_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="number|numberDecimal"
                android:digits="0123456789."
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTintMode="src_in"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:id="@+id/database_text"
            android:layout_height="wrap_content"
            android:contextClickable="false"
            app:errorMessage="@string/error_message_empty"
            app:errorType="empty"
            app:hintTextColor="@color/blue"
            app:startIconDrawable="@drawable/outline_folder_open_24"
            android:layout_marginBottom="8dp"
            app:expandedHintEnabled="false"
            app:boxStrokeWidth="1dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            android:hint="@string/database">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/database"
                android:gravity="center"
                android:inputType="text"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"/>

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F8FAFC"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <Spinner
                android:id="@+id/type_logiciel_dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:drawable/btn_dropdown"
                android:spinnerMode="dropdown" />

        </LinearLayout>

        <CheckBox
            android:id="@+id/chkbx_safe_event"
            android:text="@string/connexion_instantan"
            android:checked="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13.5sp"
            android:textColor="#1E293B"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/username_safe_event_text"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:contextClickable="false"
            android:visibility="gone"
            android:hint="@string/utilisateur"
            app:errorMessage="@string/error_message_empty"
            app:errorType="empty"
            app:expandedHintEnabled="false"
            app:hintTextColor="@color/blue"
            app:boxStrokeWidth="1dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:startIconDrawable="@drawable/outline_person_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/username_event"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="text"
                android:text=""
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:id="@+id/password_safe_event_text"
            android:layout_height="wrap_content"
            android:contextClickable="false"
            app:errorMessage="@string/error_message_empty"
            app:errorType="empty"
            android:visibility="gone"
            app:hintTextColor="@color/blue"
            app:startIconDrawable="@drawable/outline_password_24"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/blue"
            android:layout_marginBottom="4dp"
            app:expandedHintEnabled="false"
            app:boxStrokeWidth="1dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            android:hint="@string/mot_de_passe">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/password_event"
                android:gravity="center"
                android:inputType="textPassword"
                android:text=""
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"/>

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp">

        <TextView
            android:id="@+id/progress"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:visibility="visible"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true" />

    </RelativeLayout>

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingTop="4dp"
        android:paddingBottom="10dp"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btntest_connection"
            style="@style/dialog_blue_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tester_la_connexion" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_web_section_card"
        android:padding="14dp">

        <TextView
            android:id="@+id/descrip_code_depot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/saisissez_ici_le_code_depot_pour_cette_appareil_veuillez_bien_confirmer_le_code_pour_viter_plutard_le_conflis_entre_les_depots"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:lineSpacingExtra="1dp"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:id="@+id/code_depot_lnr"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="onClickListener"
            android:background="@drawable/bg_import_row_top_selector"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:ignore="UsingOnClickInXml">

            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_web_button_secondary"
                android:gravity="center">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Code dépôt"
                    android:src="@drawable/ic_baseline_home_24"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/code_depot"
                    android:textSize="12.5sp"
                    android:textColor="#64748B"
                    android:includeFontPadding="false"/>

                <TextView
                    android:id="@+id/code_depot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/_000001"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/nom_depot_lnr"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="onClickListener"
            android:background="@drawable/bg_import_row_mid_selector"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-0.8dp"
            tools:ignore="UsingOnClickInXml">

            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_web_button_map"
                android:gravity="center">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Nom dépôt"
                    android:src="@drawable/ic_baseline_done_24"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nom_depot_van"
                    android:textSize="12.5sp"
                    android:textColor="#64748B"
                    android:includeFontPadding="false"/>

                <TextView
                    android:id="@+id/nom_depot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="..."
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <Button
                android:id="@+id/get_all_depot"
                style="@style/dialog_blue_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible"
                android:text="Depots" />

        </LinearLayout>

        <View
            android:id="@+id/vieww"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/code_vendeur_lnr"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="onClickListener"
            android:background="@drawable/bg_import_row_top_selector"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:ignore="UsingOnClickInXml">

            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_web_button_gps"
                android:gravity="center">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Code vendeur"
                    android:src="@drawable/ic_baseline_person_24"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/code_vendeur"
                    android:textSize="12.5sp"
                    android:textColor="#64748B"
                    android:includeFontPadding="false"/>

                <TextView
                    android:id="@+id/code_vendeur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/_000001"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/nom_vendeur_lnr"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="onClickListener"
            android:background="@drawable/bg_import_row_bottom_selector"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-0.8dp"
            tools:ignore="UsingOnClickInXml">

            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_web_button_primary"
                android:gravity="center">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Nom vendeur"
                    android:src="@drawable/ic_baseline_check_24"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nom_vendeur"
                    android:textSize="12.5sp"
                    android:textColor="#64748B"
                    android:includeFontPadding="false"/>

                <TextView
                    android:id="@+id/nom_vendeur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="..."
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingTop="6dp">

            <Button
                android:id="@+id/get_all_vendeur"
                style="@style/dialog_blue_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible"
                android:text="Vendeurs" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"/>

</LinearLayout>
