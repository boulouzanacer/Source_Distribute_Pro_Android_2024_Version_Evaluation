<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="#F8FAFC"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/blue"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="20dp"
            android:paddingBottom="18dp">

            <TextView
                android:text="Nouveau fournisseur"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:textStyle="bold"
                android:textSize="22sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Remplissez les informations du fournisseur"
                android:textColor="#C6E0F7"
                android:textSize="13sp"
                android:layout_marginTop="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- SECTION 1 : IDENTITÉ -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="0.8dp"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="IDENTITÉ"
                            android:textColor="#64748B"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:paddingStart="3dp"
                            android:paddingBottom="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            android:layout_height="wrap_content"
                            android:layout_width="match_parent"
                            android:layout_gravity="center"
                            app:errorMessage="@string/error_message_empty"
                            app:errorType="empty"
                            android:hint="@string/nom_fournisseur"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxStrokeWidth="0.8dp"
                            app:boxStrokeWidthFocused="1.2dp"
                            android:layout_margin="3dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edt_fournisseur_name"
                                android:gravity="center"
                                android:inputType="text"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:textColorHint="#94A3B8"
                                android:layout_gravity="center"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- SECTION 2 : LOCALISATION -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="0.8dp"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="LOCALISATION"
                            android:textColor="#64748B"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:paddingStart="3dp"
                            android:paddingBottom="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            android:layout_height="wrap_content"
                            android:layout_width="match_parent"
                            android:layout_gravity="center"
                            app:errorMessage="@string/error_message_empty"
                            app:errorType="empty"
                            android:hint="@string/adresse"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxStrokeWidth="0.8dp"
                            app:boxStrokeWidthFocused="1.2dp"
                            android:layout_margin="3dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edt_fournisseur_adress"
                                android:gravity="center"
                                android:inputType="text"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:textColorHint="#94A3B8"
                                android:layout_gravity="center"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            android:layout_height="wrap_content"
                            android:layout_width="match_parent"
                            android:layout_gravity="center"
                            app:errorMessage="@string/error_message_empty"
                            app:errorType="empty"
                            android:hint="@string/phone_client_hint"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxStrokeWidth="0.8dp"
                            app:boxStrokeWidthFocused="1.2dp"
                            android:layout_margin="3dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edt_fournisseur_telephone"
                                android:gravity="center"
                                android:inputType="numberDecimal"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:textColorHint="#94A3B8"
                                android:layout_gravity="center"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- SECTION 3 : FISCAL -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="0.8dp"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="INFORMATIONS FISCALES"
                            android:textColor="#64748B"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:paddingStart="3dp"
                            android:paddingBottom="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <LinearLayout
                            android:weightSum="2"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_margin="3dp"
                                android:layout_gravity="center"
                                app:boxCornerRadiusTopStart="10dp"
                                app:boxCornerRadiusTopEnd="10dp"
                                app:boxCornerRadiusBottomStart="10dp"
                                app:boxCornerRadiusBottomEnd="10dp"
                                app:boxStrokeWidth="0.8dp"
                                app:boxStrokeWidthFocused="1.2dp"
                                app:expandedHintEnabled="false"
                                android:hint="@string/registre_commerce_hint"
                                android:layout_height="wrap_content">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edt_fournisseur_registre"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:inputType="numberDecimal"
                                    android:textStyle="bold"
                                    android:textColorHint="#94A3B8"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_margin="3dp"
                                android:layout_gravity="center"
                                app:boxCornerRadiusTopStart="10dp"
                                app:boxCornerRadiusTopEnd="10dp"
                                app:boxCornerRadiusBottomStart="10dp"
                                app:boxCornerRadiusBottomEnd="10dp"
                                app:boxStrokeWidth="0.8dp"
                                app:boxStrokeWidthFocused="1.2dp"
                                app:expandedHintEnabled="false"
                                android:hint="@string/a_i"
                                android:layout_height="wrap_content">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edt_fournisseur_ai"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:inputType="numberDecimal"
                                    android:textStyle="bold"
                                    android:textColorHint="#94A3B8"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:weightSum="2"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_margin="3dp"
                                android:layout_gravity="center"
                                app:boxCornerRadiusTopStart="10dp"
                                app:boxCornerRadiusTopEnd="10dp"
                                app:boxCornerRadiusBottomStart="10dp"
                                app:boxCornerRadiusBottomEnd="10dp"
                                app:boxStrokeWidth="0.8dp"
                                app:boxStrokeWidthFocused="1.2dp"
                                app:expandedHintEnabled="false"
                                android:hint="@string/nif_client"
                                android:layout_height="wrap_content">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edt_fournisseur_nif"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:inputType="numberDecimal"
                                    android:textStyle="bold"
                                    android:textColorHint="#94A3B8"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_margin="3dp"
                                android:layout_gravity="center"
                                app:boxCornerRadiusTopStart="10dp"
                                app:boxCornerRadiusTopEnd="10dp"
                                app:boxCornerRadiusBottomStart="10dp"
                                app:boxCornerRadiusBottomEnd="10dp"
                                app:boxStrokeWidth="0.8dp"
                                app:boxStrokeWidthFocused="1.2dp"
                                app:expandedHintEnabled="false"
                                android:hint="@string/nis_client"
                                android:layout_height="wrap_content">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edt_fournisseur_nis"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:inputType="numberDecimal"
                                    android:maxLines="1"
                                    android:textStyle="bold"
                                    android:textColorHint="#94A3B8" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- BARRE DE BOUTONS D'ACTION -->
                <LinearLayout
                    android:weightSum="2"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="8dp">

                    <com.rilixtech.materialfancybutton.MaterialFancyButton
                        android:id="@+id/btn_cancel"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:minHeight="52dp"
                        android:layout_gravity="end"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@color/blue"
                        app:mfb_icon="@drawable/ic_baseline_delete_forever_24"
                        app:mfb_textSize="16sp"
                        app:mfb_radius="12dp"
                        app:mfb_text="Annuler"
                        app:mfb_textColor="#FFFFFF" />

                    <com.rilixtech.materialfancybutton.MaterialFancyButton
                        android:id="@+id/btn_connect"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:minHeight="52dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@color/blue"
                        app:mfb_icon="@drawable/ic_baseline_check_24"
                        app:mfb_textSize="16sp"
                        app:mfb_radius="12dp"
                        app:mfb_text="Valider"
                        app:mfb_textColor="#FFFFFF" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</androidx.cardview.widget.CardView>
