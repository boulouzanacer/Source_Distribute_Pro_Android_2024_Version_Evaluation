<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:fancy="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/myToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/blue"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:navigationIcon="@drawable/ic_arrow_back_24"
        tools:titleEnabled="false" />

    <ScrollView
        android:id="@+id/scroll_detail_fournisseur"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/myToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============================================ -->
            <!-- HEADER KPI : ACHAT / VERSEMENT / SOLDE       -->
            <!-- ============================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/blue"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="18dp"
                android:layout_marginBottom="14dp"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Achat (DA)"
                            android:textSize="12sp"
                            android:letterSpacing="0.05"
                            android:textColor="#DBEAFE"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/achat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:text="@string/_0_00_da"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:typeface="monospace"
                            android:includeFontPadding="false"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <View
                        android:layout_width="0.5dp"
                        android:layout_height="42dp"
                        android:background="#7FB8EC"
                        android:layout_gravity="center"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Versement (DA)"
                            android:textSize="12sp"
                            android:letterSpacing="0.05"
                            android:textColor="#DBEAFE"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/verser"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:text="@string/_0_00_da"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:typeface="monospace"
                            android:includeFontPadding="false"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <View
                        android:layout_width="0.5dp"
                        android:layout_height="42dp"
                        android:background="#7FB8EC"
                        android:layout_gravity="center"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Solde (DA)"
                            android:textSize="12sp"
                            android:letterSpacing="0.05"
                            android:textColor="#DBEAFE"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/solde"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:text="@string/_0_00_da"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:typeface="monospace"
                            android:includeFontPadding="false"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ============================================ -->
            <!-- CARD 1 : IDENTITÉ DU FOURNISSEUR             -->
            <!-- ============================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_web_section_card"
                android:layout_marginBottom="14dp">

                <!-- TITRE DE SECTION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IDENTITÉ FOURNISSEUR"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.05"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="8dp"/>

                <!-- NOM + CODE + MODE TARIF (100% largeur, plus avatar) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <!-- INFOS (100% largeur) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="#F8FAFC"
                            android:paddingStart="10dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nom / Prénom"
                                android:textSize="11sp"
                                android:textColor="#94A3B8"
                                android:layout_marginBottom="3dp"/>

                            <TextView
                                android:id="@+id/fournisseur_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BOULOUZA NASSER"
                                android:textColor="#0F172A"
                                android:textSize="15sp"
                                android:textStyle="bold"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="#F8FAFC"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Code fournisseur"
                                android:textSize="11sp"
                                android:textColor="#94A3B8"
                                android:layout_marginBottom="3dp"/>

                            <TextView
                                android:id="@+id/code_frs"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12551255"
                                android:textColor="#1E3A8A"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:typeface="monospace"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="#FEF3C7"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mode de tarif"
                                android:textSize="11sp"
                                android:textColor="#92400E"
                                android:layout_marginBottom="3dp"/>

                            <TextView
                                android:id="@+id/mode_tarif"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/carot"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- TÉLÉPHONE + APPEL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#ECFDF5"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:weightSum="5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="5">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="4"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Téléphone"
                                android:textSize="11sp"
                                android:textColor="#065F46"
                                android:layout_marginBottom="3dp"/>

                            <TextView
                                android:id="@+id/tel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0552725211"
                                android:textStyle="bold"
                                android:textColor="#065F46"
                                android:textSize="15sp"
                                android:typeface="monospace"/>
                        </LinearLayout>

                        <mehdi.sakout.fancybuttons.FancyButton
                            android:id="@+id/btnCall"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:onClick="onClick"
                            fancy:fb_borderColor="#FFFFFF"
                            fancy:fb_borderWidth="0dp"
                            fancy:fb_defaultColor="@color/emerald"
                            fancy:fb_focusColor="#059669"
                            fancy:fb_iconPosition="left"
                            fancy:fb_iconPaddingLeft="0dp"
                            fancy:fb_iconResource="@drawable/ic_baseline_local_phone_white_24"
                            fancy:fb_radius="10dp"
                            fancy:fb_text=""
                            fancy:fb_textColor="#FFFFFF" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ADRESSE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#F8FAFC"
                    android:paddingStart="5dp"
                    android:paddingBottom="14dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adresse"
                        android:textSize="11sp"
                        android:textColor="#94A3B8"
                        android:layout_marginBottom="3dp"/>

                    <TextView
                        android:id="@+id/adresse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10500, Cité les HLM, Oran"
                        android:textColor="#334155"
                        android:textSize="13sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- ============================================ -->
            <!-- CARD 2 : LOCALISATION & CARTE (ANNULÉ : on remet la carte statique) -->
            <!-- ============================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_web_section_card"
                android:layout_marginBottom="14dp">

                <!-- TITRE DE SECTION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LOCALISATION GPS"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp"/>

                <!-- ACTIONS : UPDATE + ITINÉRAIRE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="12dp">

                    <mehdi.sakout.fancybuttons.FancyButton
                        android:id="@+id/btn_update_pos"
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        android:layout_gravity="center"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:onClick="onClick"
                        fancy:fb_borderColor="#FFFFFF"
                        fancy:fb_borderWidth="0dp"
                        fancy:fb_defaultColor="@color/blue"
                        fancy:fb_focusColor="@color/blue_btn_bg_color"
                        fancy:fb_iconPosition="left"
                        fancy:fb_iconPaddingLeft="6dp"
                        fancy:fb_iconResource="@drawable/ic_baseline_update_location_24"
                        fancy:fb_radius="10dp"
                        fancy:fb_text="M.A.J position"
                        fancy:fb_textColor="#FFFFFF"
                        fancy:fb_textSize="13sp" />

                    <mehdi.sakout.fancybuttons.FancyButton
                        android:id="@+id/btn_itenerary"
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:onClick="onClick"
                        fancy:fb_borderColor="#FFFFFF"
                        fancy:fb_borderWidth="0dp"
                        fancy:fb_defaultColor="@color/blue"
                        fancy:fb_focusColor="@color/blue_btn_bg_color"
                        fancy:fb_iconPosition="left"
                        fancy:fb_iconPaddingLeft="6dp"
                        fancy:fb_iconResource="@drawable/ic_baseline_itenerary_24"
                        fancy:fb_radius="10dp"
                        fancy:fb_text="Itinéraire"
                        fancy:fb_textColor="#FFFFFF"
                        fancy:fb_textSize="13sp" />

                </LinearLayout>

                <!-- CARTE STATIQUE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#F1F5F9"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/imgv_fournisseur_map"
                        android:layout_width="match_parent"
                        android:layout_height="190dp"
                        android:layout_gravity="center"
                        android:background="@color/white"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/noimg" />

                </LinearLayout>

            </LinearLayout>

            <!-- ============================================ -->
            <!-- CARD 2 : HISTORIQUE DES VERSEMENTS           -->
            <!-- ============================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_web_section_card"
                android:layout_marginBottom="10dp">

                <!-- TITRE DE SECTION + ACTION VERSER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="12dp"
                    android:weightSum="5">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2.2"
                        android:text="VERSEMENTS / SITUATION"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:layout_gravity="center_vertical"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="0.8"/>

                    <mehdi.sakout.fancybuttons.FancyButton
                        android:id="@+id/btnVerser"
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        android:layout_weight="2"
                        android:layout_gravity="center_vertical"
                        android:onClick="onClick"
                        fancy:fb_borderColor="#FFFFFF"
                        fancy:fb_borderWidth="0dp"
                        fancy:fb_defaultColor="@color/emerald"
                        fancy:fb_focusColor="#059669"
                        fancy:fb_iconPosition="left"
                        fancy:fb_iconPaddingLeft="8dp"
                        fancy:fb_iconResource="@drawable/ic_baseline_payments_24"
                        fancy:fb_radius="12dp"
                        fancy:fb_text="  Nouveau versement"
                        fancy:fb_textColor="#FFFFFF"
                        fancy:fb_textSize="13sp" />

                    <mehdi.sakout.fancybuttons.FancyButton
                        android:id="@+id/btnAchat"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="2"
                        android:layout_gravity="center_vertical"
                        android:onClick="onClick"
                        android:visibility="gone"
                        fancy:fb_borderColor="#FFFFFF"
                        fancy:fb_borderWidth="0dp"
                        fancy:fb_defaultColor="@color/emerald"
                        fancy:fb_focusColor="#059669"
                        fancy:fb_iconPosition="left"
                        fancy:fb_iconPaddingLeft="8dp"
                        fancy:fb_radius="12dp"
                        fancy:fb_text="  Achat"
                        fancy:fb_textColor="#FFFFFF"
                        fancy:fb_textSize="13sp" />

                </LinearLayout>

                <!-- EN-TÊTE AVEC BOUTONS ÉDITION/SUPPRESSION -->
                <LinearLayout
                    android:background="@color/blue"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:orientation="horizontal"
                    android:weightSum="10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/date_versement_value1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:text="Date" />

                    <TextView
                        android:id="@+id/heure_versement_value1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:text="Heure" />

                    <TextView
                        android:id="@+id/montant_versement_value1"
                        android:layout_marginStart="10dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:textColor="#FFFFFF"
                        android:text="Montant" />

                    <ImageView
                        android:id="@+id/btn_edit_situation"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:layout_height="wrap_content"
                        android:contentDescription="Modifier"
                        android:src="@drawable/ic_baseline_edit_24"
                        app:tint="#FFFFFF"
                        android:padding="2dp"/>

                    <ImageView
                        android:id="@+id/btn_remove_situation"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_height="wrap_content"
                        android:contentDescription="Supprimer"
                        android:src="@drawable/ic_baseline_delete_24"
                        app:tint="#FFFFFF"
                        android:padding="2dp"/>

                </LinearLayout>

                <!-- RV -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="120dp"
                    android:background="#FFFFFF"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_view_fournisseur_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    </androidx.recyclerview.widget.RecyclerView>
                </RelativeLayout>

            </LinearLayout>

            <!-- ESPACE FINAL -->
            <View
                android:layout_width="match_parent"
                android:layout_height="10dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
