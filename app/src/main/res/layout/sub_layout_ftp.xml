<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/param_ftp"
    android:visibility="gone"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_web_section_card">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Serveur FTP"
            android:textColor="#0F172A"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:includeFontPadding="false"/>

        <LinearLayout
            android:id="@+id/rtv2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_height="wrap_content"
                android:gravity="center_vertical|start"
                android:layout_width="96dp"
                android:textColor="#334155"
                android:textStyle="bold"
                android:textSize="13.5sp"
                android:text="@string/serveur_ftp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:layout_marginStart="8dp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:inputType="text"
                android:id="@+id/serveur_ftp"
                android:hint="@string/serveur_ftp"
                android:background="@drawable/bg_web_edit_outlined"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:gravity="center_vertical"
                tools:ignore="Autofill" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rtv3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|start"
                android:text="@string/n_de_port"
                android:textColor="#334155"
                android:textStyle="bold"
                android:textSize="13.5sp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/port_ftp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:hint="@string/n_de_port"
                android:inputType="number"
                android:background="@drawable/bg_web_edit_outlined"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:gravity="center_vertical"
                tools:ignore="Autofill" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rtv5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="96dp"
                android:gravity="center_vertical|start"
                android:textColor="#334155"
                android:textStyle="bold"
                android:textSize="13.5sp"
                android:text="@string/utilisateur" />

            <androidx.appcompat.widget.AppCompatEditText
                android:layout_marginStart="8dp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:inputType="text"
                android:id="@+id/utilisateur_ftp"
                android:hint="@string/utilisateur"
                android:background="@drawable/bg_web_edit_outlined"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:gravity="center_vertical"
                tools:ignore="Autofill" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|start"
                android:text="@string/mot_de_passe"
                android:textColor="#334155"
                android:textStyle="bold"
                android:textSize="13.5sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/blue"
                app:boxStrokeWidth="1dp"
                app:boxStrokeColor="@color/blue"
                app:hintTextColor="@color/blue"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                android:hint="@string/mot_de_passe">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pwd_ftp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"/>

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_web_section_card"
        android:padding="14dp"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/descrip_exp_ftp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|start"
            android:text="@string/nom_du_dossier_ftp_des_exportations_des_donn_es"
            android:textColor="#334155"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/exp_ftp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            android:hint="@string/nom_du_dossier_ftp_des_exportations_des_donn_es"
            android:inputType="text"
            android:text="@string/imp"
            android:background="@drawable/bg_web_edit_outlined"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:gravity="center_vertical"
            tools:ignore="Autofill" />

        <TextView
            android:id="@+id/descrip_imp_ftp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|start"
            android:text="@string/nom_du_dossier_ftp_des_importations_des_donn_es"
            android:textColor="#334155"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:paddingBottom="6dp"
            tools:ignore="HardcodedText" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/imp_ftp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="@string/nom_du_dossier_ftp_des_importations_des_donn_es"
            android:inputType="text"
            android:text="@string/exp"
            android:background="@drawable/bg_web_edit_outlined"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:gravity="center_vertical"
            tools:ignore="Autofill" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingTop="10dp">
        <Button
            android:id="@+id/save_ftp"
            style="@style/dialog_blue_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/enregistrer_les_param_tres_ftp" />
    </LinearLayout>
</LinearLayout>
