<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    android:fillViewport="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_web_section_card"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:background="@drawable/bg_web_header_blue"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/timbre"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F5F3FF"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="6dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎯 MONTANT TIMBRE"
                    android:textColor="#6D28D9"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="3dp"
                    android:paddingStart="2dp" />

                <LinearLayout
                    android:weightSum="1"
                    android:baselineAligned="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:contextClickable="false"
                        android:layout_weight="1"
                        app:boxStrokeColor="#6D28D9"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:errorMessage="@string/error_message_empty"
                        app:errorType="empty"
                        app:hintTextColor="@color/blue"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_marginBottom="3dp"
                        app:expandedHintEnabled="false"
                        app:helperText="@string/montant_timbre">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/montant_timbre"
                            android:gravity="center"
                            android:inputType="numberSigned|numberDecimal"
                            android:layout_gravity="center"
                            android:textStyle="bold"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:backgroundTint="#EDE9FE" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:weightSum="2"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="10dp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.rilixtech.materialfancybutton.MaterialFancyButton
                android:id="@+id/btn_timbre"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:minHeight="52dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_web_button_primary"
                app:mfb_icon="@drawable/ic_baseline_check_24"
                app:mfb_textSize="16sp"
                app:mfb_radius="12dp"
                app:mfb_text="Valider"
                app:mfb_textColor="#FFFFFF" />

            <com.rilixtech.materialfancybutton.MaterialFancyButton
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:minHeight="52dp"
                android:layout_gravity="right"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_web_button_secondary"
                app:mfb_icon="@drawable/ic_baseline_delete_forever_24"
                app:mfb_textSize="16sp"
                app:mfb_radius="12dp"
                app:mfb_text="Annuler"
                app:mfb_textColor="#0F172A" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
