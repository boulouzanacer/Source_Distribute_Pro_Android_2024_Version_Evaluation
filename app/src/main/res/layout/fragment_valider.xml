<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    android:fillViewport="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_web_section_card"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:background="@drawable/bg_web_header_blue"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/versement"
                android:gravity="center"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#EFF6FF"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="6dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 SOLDES ACTUELS"
                    android:textColor="#1D4ED8"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="3dp"
                    android:paddingStart="2dp" />

                <LinearLayout
                    android:weightSum="2"
                    android:baselineAligned="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:contextClickable="false"
                        android:layout_weight="1"
                        app:boxStrokeColor="#1D4ED8"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:errorType="empty"
                        app:hintTextColor="@color/blue"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_marginBottom="3dp"
                        app:expandedHintEnabled="false"
                        app:helperText="  "
                        android:hint="@string/ancien_solde">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/ancien_sold"
                            android:gravity="center"
                            android:inputType="none"
                            android:layout_gravity="center"
                            android:textStyle="bold"
                            android:enabled="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#DBEAFE" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:contextClickable="false"
                        android:layout_weight="1"
                        app:boxStrokeColor="#1D4ED8"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:errorType="empty"
                        app:hintTextColor="@color/blue"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_marginBottom="3dp"
                        app:expandedHintEnabled="false"
                        app:helperText="  "
                        android:hint="@string/montant_bon_actuel">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/montant_bon_actuel"
                            android:gravity="center"
                            android:inputType="none"
                            android:layout_gravity="center"
                            android:textStyle="bold"
                            android:enabled="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#DBEAFE" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:layout_gravity="center"
                    android:contextClickable="false"
                    app:boxStrokeColor="#1D4ED8"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:errorMessage="@string/error_message_empty"
                    app:errorType="empty"
                    android:hint="@string/solde_actuel"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="3dp"
                    app:expandedHintEnabled="false"
                    app:helperText="   ">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/solde_actuel"
                        android:gravity="center"
                        android:inputType="none"
                        android:enabled="false"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#DBEAFE" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF7ED"
                android:orientation="vertical"
                android:layout_marginTop="2dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="6dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💸 CHARGE MONTANT BON"
                    android:textColor="#C2410C"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="3dp"
                    android:paddingStart="2dp" />

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/charge_montant_bon"
                        android:text="Montant Bon -&gt;"
                        android:textColor="@color/blue"
                        android:layout_marginEnd="8dp"
                        android:gravity="end|bottom"
                        android:textAlignment="textEnd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:contextClickable="false"
                        app:boxStrokeColor="#C2410C"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:errorMessage="@string/error_message_empty"
                        app:errorType="empty"
                        app:hintTextColor="@color/blue"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_marginBottom="3dp"
                        app:expandedHintEnabled="false"
                        app:helperText="   "
                        android:hint="@string/versement">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/versement"
                            android:gravity="center"
                            android:inputType="numberDecimal|numberSigned"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:layout_gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#FFEDD5" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ECFDF5"
                android:orientation="vertical"
                android:layout_marginTop="2dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="6dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💚 NOUVEAU SOLDE"
                    android:textColor="#047857"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="3dp"
                    android:paddingStart="2dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:contextClickable="false"
                    app:boxStrokeColor="#047857"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:errorMessage="@string/error_message_empty"
                    app:errorType="empty"
                    app:hintTextColor="@color/blue"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="3dp"
                    app:expandedHintEnabled="false"
                    app:helperText="  "
                    android:hint="@string/nouveau_solde">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nouveau_solde"
                        android:gravity="center"
                        android:inputType="none"
                        android:enabled="false"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#D1FAE5" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:weightSum="2"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="10dp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.rilixtech.materialfancybutton.MaterialFancyButton
                android:id="@+id/btn_connect"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:minHeight="52dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_web_button_primary"
                app:mfb_icon="@drawable/ic_baseline_check_24"
                app:mfb_textSize="16sp"
                app:mfb_radius="12dp"
                app:mfb_text="Valider"
                app:mfb_textColor="#FFFFFF" />

            <com.rilixtech.materialfancybutton.MaterialFancyButton
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:minHeight="52dp"
                android:layout_gravity="right"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_web_button_secondary"
                app:mfb_icon="@drawable/ic_baseline_delete_forever_24"
                app:mfb_textSize="16sp"
                app:mfb_radius="12dp"
                app:mfb_text="Annuler"
                app:mfb_textColor="#0F172A" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
