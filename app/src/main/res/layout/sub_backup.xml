<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:visibility="gone"
    android:id="@+id/param_backup"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/a_vous_permet_de_faire_une_sauvegarde_des_donn_es_une_copie_du_base_de_donn_es_sur_un_serveur_distant_et_meme_la_restauration_de_vos_donn_es"
        android:textSize="12sp"
        android:textColor="#64748B" />

    <LinearLayout
        android:id="@+id/backup_confique"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_web_section_card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:onClick="onClickListener"
        android:padding="14dp"
        tools:ignore="RtlSymmetry,UsingOnClickInXml">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Configuration Cloud"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <LinearLayout
            android:weightSum="10"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dip"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:textColor="#0F172A"
                android:text="Email :"
                android:clickable="false"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtv_email_cloud"
                android:layout_width="0dip"
                android:layout_height="wrap_content"
                android:layout_weight="7"
                android:textColor="#64748B"
                android:text="boulouza.nacer@gmail.com"
                android:clickable="false"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:weightSum="10"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="0dip"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:textColor="#0F172A"
                android:text="Password :"
                android:clickable="false"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtv_password_cloud"
                android:layout_width="0dip"
                android:layout_height="wrap_content"
                android:layout_weight="7"
                android:textColor="#64748B"
                android:text="12345678"
                android:clickable="false"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end">

        <Button
            android:id="@+id/btn_deconecte_cloud"
            style="@style/dialog_blue_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Déconnexion" />

        <Button
            android:id="@+id/btn_login_cloud"
            style="@style/dialog_blue_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Connexion" />

        <Button
            android:id="@+id/btn_signup_cloud"
            style="@style/dialog_blue_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inscription" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/backup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_web_section_card"
        android:clickable="true"
        android:focusable="true"
        android:onClick="onClickListener"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:layout_marginTop="14dp"
        tools:ignore="RtlSymmetry,UsingOnClickInXml">

        <TextView
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#0F172A"
            android:text="@string/sauvegarder_backup"
            android:clickable="false"
            android:textSize="14.5sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/lnr_auto_backup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_web_section_card"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sauvegarde_automatique"
                android:textColor="#0F172A"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switch_auto_backup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                tools:ignore="UseSwitchCompatOrMaterialXml" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtv_auto_backup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sauvegarde_automatique_desc"
            android:textColor="#64748B"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/restore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_web_section_card"
        android:clickable="true"
        android:focusable="true"
        android:onClick="onClickListener"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:layout_marginTop="12dp"
        tools:ignore="RtlSymmetry,UsingOnClickInXml">

        <TextView
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#0F172A"
            android:text="@string/restorer_backup"
            android:clickable="false"
            android:textSize="14.5sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="ça vous permet d'afficher / masquer le button mise à jour dans le menu principale pour pouvoir mettre à jour l'application"
        android:textSize="12sp"
        android:textColor="#64748B" />
</LinearLayout>
