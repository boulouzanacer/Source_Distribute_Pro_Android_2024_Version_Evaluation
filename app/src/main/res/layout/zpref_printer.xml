<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/param_impr"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone"
    android:layout_marginBottom="20dp"
    android:paddingHorizontal="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:text="@string/s_l_ctionnez_l_imprimente_qui_vous_permetra_d_imprimer_les_tickets" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_web_section_card"
        android:orientation="vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:text="@string/s_l_ctionner_imprimente" />

        <com.safesoft.proapp.distribute.view.FlowRadioGroup
            android:id="@+id/rg_connect"
            android:weightSum="4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <RadioButton
                android:id="@+id/rb_connect_bluetooth"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Bluetooth"
                android:textSize="12sp"
                android:textColor="#0F172A" />

            <RadioButton
                android:id="@+id/rb_connect_wifi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:checked="true"
                android:text="WiFi"
                android:textSize="12sp"
                android:textColor="#0F172A" />

            <RadioButton
                android:id="@+id/rb_connect_usb"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="USB"
                android:textSize="12sp"
                android:textColor="#0F172A"
                android:visibility="visible" />

            <RadioButton
                android:id="@+id/rb_connect_com"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="COM"
                android:textSize="12sp"
                android:textColor="#0F172A"
                android:visibility="visible" />

        </com.safesoft.proapp.distribute.view.FlowRadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:text="@string/model_imprimente" />

        <com.safesoft.proapp.distribute.view.FlowRadioGroup
            android:id="@+id/rg_type_imprimente"
            android:weightSum="2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <RadioButton
                android:id="@+id/rb_type_ticket"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Impriment ticket "
                android:textSize="12sp"
                android:textColor="#0F172A" />

            <RadioButton
                android:id="@+id/rb_type_codebarre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="false"
                android:text="Impriment codebarre "
                android:textSize="12sp"
                android:textColor="#0F172A" />

        </com.safesoft.proapp.distribute.view.FlowRadioGroup>

        <TextView
            android:id="@+id/mode_app_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:text="Mode app"
            android:visibility="gone" />

        <com.safesoft.proapp.distribute.view.FlowRadioGroup
            android:id="@+id/rg_mode_app"
            android:weightSum="2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <RadioButton
                android:id="@+id/rb_mode_app_4barcode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="false"
                android:text="Via app 4Barcode"
                android:textSize="12sp"
                android:textColor="#0F172A" />

            <RadioButton
                android:id="@+id/rb_mode_app_sdk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Via SDK"
                android:textSize="12sp"
                android:textColor="#0F172A" />

        </com.safesoft.proapp.distribute.view.FlowRadioGroup>

        <TextView
            android:id="@+id/langue_ticket_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:text="Langue ticket"
            android:visibility="visible" />

        <com.safesoft.proapp.distribute.view.FlowRadioGroup
            android:id="@+id/rg_langue_ticket"
            android:weightSum="2"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <RadioButton
                android:id="@+id/rb_langue_latin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Ticket latin "
                android:textSize="12sp"
                android:textColor="#0F172A" />

            <RadioButton
                android:id="@+id/rb_langue_arabe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="false"
                android:text="Ticket arabe"
                android:textSize="12sp"
                android:textColor="#0F172A" />

        </com.safesoft.proapp.distribute.view.FlowRadioGroup>

        <TextView
            android:id="@+id/model_ticket_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:text="@string/model_ticket"
            android:visibility="visible" />

        <com.safesoft.proapp.distribute.view.FlowRadioGroup
            android:id="@+id/rg_model_latin_ticket"
            android:weightSum="2"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <RadioButton
                android:id="@+id/rb_model_latin_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Model latin 1"
                android:textSize="12sp"
                android:textColor="#0F172A" />

            <RadioButton
                android:id="@+id/rb_model_latin_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="false"
                android:text="Model latin 2"
                android:textSize="12sp"
                android:textColor="#0F172A" />

        </com.safesoft.proapp.distribute.view.FlowRadioGroup>

        <com.safesoft.proapp.distribute.view.FlowRadioGroup
            android:id="@+id/rg_model_ticket_codebarre"
            android:weightSum="3"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <RadioButton
                android:id="@+id/rg_model_ticket_codebarre_50X30"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="M 50 X 30"
                android:textSize="12sp"
                android:textColor="#0F172A" />

            <RadioButton
                android:id="@+id/rg_model_ticket_codebarre_40X20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="false"
                android:text="M 40 X 20"
                android:textSize="12sp"
                android:textColor="#0F172A" />

            <RadioButton
                android:id="@+id/rg_model_ticket_codebarre_40X20_without_codebarre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="false"
                android:text="M 40 X 20 Sans CB"
                android:textSize="12sp"
                android:textColor="#0F172A" />

        </com.safesoft.proapp.distribute.view.FlowRadioGroup>

        <com.safesoft.proapp.distribute.view.FlowRadioGroup
            android:id="@+id/rg_model_arabe_ticket"
            android:weightSum="2"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <RadioButton
                android:id="@+id/rb_model_arabe_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Model arabe 1"
                android:textSize="12sp"
                android:textColor="#0F172A" />

            <RadioButton
                android:id="@+id/rb_model_arabe_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="false"
                android:text="Model arabe 2"
                android:textSize="12sp"
                android:textColor="#0F172A" />

        </com.safesoft.proapp.distribute.view.FlowRadioGroup>

        <Button
            android:id="@+id/btn_connected_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:paddingVertical="10dp"
            android:backgroundTint="#2563EB"
            android:textColor="@color/white"
            android:text="Choisissez un périphérique à connecté" />

        <TextView
            android:id="@+id/tv_device_selected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_web_section_card"
            android:gravity="center"
            android:padding="14dp"
            android:textSize="13sp"
            android:textColor="#0F172A"
            android:tag="-1" />

        <ProgressBar
            android:id="@+id/pb_connect"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_disConnect_printer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:enabled="false"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:paddingVertical="10dp"
                android:backgroundTint="#EF4444"
                android:textColor="@color/white"
                android:text="Déconnecter" />

            <Button
                android:id="@+id/btn_connect_printer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:paddingVertical="10dp"
                android:backgroundTint="#2563EB"
                android:textColor="@color/white"
                android:text="Connecter" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tester impression"
            android:enabled="false"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:paddingVertical="10dp"
            android:backgroundTint="#10B981"
            android:textColor="@color/white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Espace footer"
            android:textColor="#0F172A"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp" />

        <Spinner
            android:id="@+id/espace_footer_dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_web_section_card"
            android:spinnerMode="dropdown" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_web_section_card"
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:text="@string/affichez_l_entete_de_soci_t_sur_le_bon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <ImageView
            android:id="@+id/comapny_logo"
            android:layout_gravity="center"
            android:src="@mipmap/user_profile"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_web_section_card"
            android:padding="8dp"
            android:scaleType="centerInside" />

        <Button
            android:id="@+id/btn_clear_logo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:paddingVertical="10dp"
            android:backgroundTint="#64748B"
            android:textColor="@color/white"
            android:text="Effacer logo" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            app:errorMessage="@string/error_message_empty"
            app:errorType="empty"
            android:hint="Nom d'entreprise"
            app:expandedHintEnabled="false"
            app:helperText="  "
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#E5E7EB"
            app:boxStrokeErrorColor="#EF4444"
            app:hintTextColor="#64748B"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_company_name"
                android:gravity="start"
                android:inputType="text"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            app:errorMessage="@string/error_message_empty"
            app:errorType="empty"
            android:hint="L'activité"
            app:expandedHintEnabled="false"
            app:helperText="  "
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#E5E7EB"
            app:boxStrokeErrorColor="#EF4444"
            app:hintTextColor="#64748B"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_activity_name"
                android:gravity="start"
                android:inputType="text"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            app:errorMessage="@string/error_message_empty"
            app:errorType="empty"
            android:hint="L'adresse de l'entreprise"
            app:expandedHintEnabled="false"
            app:helperText="  "
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#E5E7EB"
            app:boxStrokeErrorColor="#EF4444"
            app:hintTextColor="#64748B"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_company_adresse"
                android:gravity="start"
                android:inputType="text"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            app:errorMessage="@string/error_message_empty"
            app:errorType="empty"
            android:hint="Téléphone d'entreprise"
            app:expandedHintEnabled="false"
            app:helperText="  "
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#E5E7EB"
            app:boxStrokeErrorColor="#EF4444"
            app:hintTextColor="#64748B">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_company_tel"
                android:gravity="start"
                android:inputType="text"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_web_section_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:text="@string/affichez_le_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            app:errorMessage="@string/error_message_empty"
            app:errorType="empty"
            android:hint="Pied de page"
            app:expandedHintEnabled="false"
            app:helperText="  "
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#E5E7EB"
            app:boxStrokeErrorColor="#EF4444"
            app:hintTextColor="#64748B">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_pied_de_page"
                android:gravity="start"
                android:inputType="text"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

</LinearLayout>
