<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    android:orientation="vertical"
    tools:context="com.safesoft.proapp.distribute.activities.client.ActivityClients">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/myToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/blue"
        app:popupTheme="@style/AppTheme.PopupOverlay"
        app:titleTextColor="@color/white"
        app:subtitleTextColor="#E2E8F0"
        app:titleEnabled="true"
        app:navigationIcon="@drawable/ic_arrow_back_24" />

    <!-- CHIP SEGMENTED : JOUR / SEMAINE / MOIS -->
    <LinearLayout
        android:id="@+id/chip_group_periode"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:background="#E2E8F0"
        android:padding="3dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/chip_jour"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Jour"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:background="@drawable/bg_chip_segmented_selected"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/chip_semaine"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Semaine"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:background="@drawable/bg_chip_segmented_unselected"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/chip_mois"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Mois"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:background="@drawable/bg_chip_segmented_unselected"/>

    </LinearLayout>

    <!-- 2 KPI CARDS : TOTAL VERSEMENT + TOTAL SOLDE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:background="@drawable/bg_web_section_card"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_web_button_map"
                android:layout_marginBottom="10dp"
                android:gravity="center">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Paiements encaissés"
                    android:src="@drawable/ic_baseline_backup_24"
                    tools:ignore="ContentDescription"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Versement"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/kpi_total_versement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="1 532 420,00 DA"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:includeFontPadding="false"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:background="@drawable/bg_web_section_card"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_web_button_gps"
                android:layout_marginBottom="10dp"
                android:gravity="center">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Solde total"
                    android:src="@drawable/ic_baseline_wallet_24"
                    tools:ignore="ContentDescription"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Solde"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/kpi_total_solde"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="703 656,00 DA"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:includeFontPadding="false"/>

        </LinearLayout>

    </LinearLayout>

    <!-- TITRE SECTION LISTE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tous les clients"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:includeFontPadding="false"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_client"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

</LinearLayout>
