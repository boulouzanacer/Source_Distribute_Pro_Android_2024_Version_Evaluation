<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    android:fillViewport="true">

    <androidx.cardview.widget.CardView
        android:id="@+id/root_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="15dp"
        app:cardBackgroundColor="#F8FAFC"
        app:cardUseCompatPadding="true"
        app:strokeColor="#CBD5E1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8FAFC"
            android:orientation="vertical">

            <!-- HEADER GRADIENT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="82dp"
                android:background="@drawable/bg_header_clients_pro"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saisie de vente"
                        android:textSize="12sp"
                        android:textColor="#BFDBFE"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="3dp"/>

                    <TextView
                        android:id="@+id/produit_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1/2 BENTOUMIA"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif"
                        android:layout_marginBottom="2dp"
                        tools:ignore="HardcodedText"/>

                    <TextView
                        android:id="@+id/message_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FEE2E2"
                        android:textSize="12sp"
                        android:layout_marginBottom="1dp" />

                    <TextView
                        android:id="@+id/promotion_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FDBA74"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- CONTENT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <!-- SECTION 1 : STOCK DISPONIBLE -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#BFDBFE"
                    app:strokeWidth="0.7dp"
                    app:cardUseCompatPadding="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#EFF6FF"
                        android:orientation="vertical"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📦 STOCK DISPONIBLE"
                            android:textColor="#1D4ED8"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="sans-serif-medium" />

                        <LinearLayout
                            android:orientation="horizontal"
                            android:weightSum="2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_height="wrap_content"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_gravity="center"
                                android:contextClickable="false"
                                app:boxStrokeColor="#1D4ED8"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp"
                                app:errorMessage="@string/error_message_empty"
                                app:errorType="empty"
                                android:hint="@string/qt_en_stock_unit"
                                app:expandedHintEnabled="false"
                                app:helperText="  "
                                android:layout_marginStart="2dp"
                                android:layout_marginEnd="2dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/stockavant"
                                    android:gravity="center"
                                    android:inputType="none"
                                    android:enabled="false"
                                    android:textStyle="bold"
                                    android:textColor="#0F172A"
                                    android:layout_gravity="center"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    android:backgroundTint="#DBEAFE" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:id="@+id/stockavantLayout_colis"
                                android:layout_height="wrap_content"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_gravity="center"
                                android:contextClickable="false"
                                app:boxStrokeColor="#1D4ED8"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp"
                                app:errorMessage="@string/error_message_empty"
                                app:errorType="empty"
                                android:visibility="visible"
                                android:hint="@string/qt_en_stock_colis"
                                app:expandedHintEnabled="false"
                                app:helperText="  "
                                android:layout_marginStart="2dp"
                                android:layout_marginEnd="2dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/stockavant_colis"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:enabled="false"
                                    android:gravity="center"
                                    android:inputType="none"
                                    android:textColor="#0F172A"
                                    android:textStyle="bold"
                                    android:textSize="12sp"
                                    android:backgroundTint="#DBEAFE" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- SECTION 2 : QUANTITÉS -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#FED7AA"
                    app:strokeWidth="0.7dp"
                    app:cardUseCompatPadding="false">

                    <LinearLayout
                        android:id="@+id/part_3_qtevente_Layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFF7ED"
                        android:orientation="vertical"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:weightSum="4">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🧮 QUANTITÉS À VENDRE"
                            android:textColor="#C2410C"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="sans-serif-medium" />

                        <LinearLayout
                            android:weightSum="4"
                            android:layout_width="match_parent"
                            android:orientation="horizontal"
                            android:layout_height="wrap_content">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_gravity="center"
                                app:boxStrokeColor="#C2410C"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp"
                                android:hint="@string/n_colis"
                                app:expandedHintEnabled="false"
                                android:layout_marginStart="2dp"
                                android:layout_marginEnd="2dp"
                                android:layout_height="wrap_content">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/nbrColis"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:inputType="numberSigned|numberDecimal"
                                    android:textStyle="bold"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    android:backgroundTint="#FFEDD5" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_gravity="center"
                                app:boxStrokeColor="#C2410C"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp"
                                android:hint="@string/colis"
                                app:expandedHintEnabled="false"
                                android:layout_marginStart="2dp"
                                android:layout_marginEnd="2dp"
                                android:layout_height="wrap_content">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/colissage"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:inputType="numberSigned|numberDecimal"
                                    android:textStyle="bold"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    android:backgroundTint="#FFEDD5" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/qteLayout"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_gravity="center"
                                app:boxStrokeColor="#C2410C"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp"
                                android:hint="@string/qt"
                                android:visibility="visible"
                                app:expandedHintEnabled="false"
                                android:layout_marginStart="2dp"
                                android:layout_marginEnd="2dp"
                                android:layout_height="wrap_content">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/qte"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:inputType="numberSigned|numberDecimal"
                                    android:textStyle="bold"
                                    android:textSize="12sp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:backgroundTint="#FFEDD5" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/gratuitLayout"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_gravity="center"
                                app:boxStrokeColor="#C2410C"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp"
                                android:visibility="visible"
                                android:hint="@string/gratuit"
                                app:expandedHintEnabled="false"
                                android:layout_marginStart="2dp"
                                android:layout_marginEnd="2dp"
                                android:layout_height="wrap_content">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/gratuit"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:inputType="numberSigned|numberDecimal"
                                    android:textStyle="bold"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    android:backgroundTint="#FFEDD5" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- SECTION 3 : TARIFICATION -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#A7F3D0"
                    app:strokeWidth="0.7dp"
                    app:cardUseCompatPadding="false">

                    <LinearLayout
                        android:id="@+id/ly_prix"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#ECFDF5"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:weightSum="5">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="💲 TARIFICATION"
                            android:textColor="#047857"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="sans-serif-medium" />

                        <LinearLayout
                            android:weightSum="5"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/prixhtLayout"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_weight="2"
                                android:layout_gravity="center"
                                app:boxStrokeColor="#047857"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp"
                                android:visibility="visible"
                                android:hint="Prix HT"
                                app:expandedHintEnabled="false"
                                android:layout_marginStart="2dp"
                                android:layout_marginEnd="2dp"
                                android:layout_height="wrap_content">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/prixht"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:inputType="numberSigned|numberDecimal"
                                    android:textStyle="bold"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    android:backgroundTint="#D1FAE5" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tvaLayout"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_gravity="center"
                                app:boxStrokeColor="#047857"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp"
                                android:hint="Tva"
                                android:visibility="visible"
                                app:expandedHintEnabled="false"
                                android:layout_marginStart="2dp"
                                android:layout_marginEnd="2dp"
                                android:layout_height="wrap_content">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/tva"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:inputType="numberSigned|numberDecimal"
                                    android:textStyle="bold"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    android:backgroundTint="#D1FAE5" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_weight="2"
                                android:layout_gravity="center"
                                app:boxStrokeColor="#047857"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp"
                                android:hint="Prix TTC"
                                app:expandedHintEnabled="false"
                                android:layout_marginStart="2dp"
                                android:layout_marginEnd="2dp"
                                android:layout_height="wrap_content">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/prixttc"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:inputType="numberSigned|numberDecimal"
                                    android:textStyle="bold"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    android:backgroundTint="#D1FAE5" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- SECTION 4 : STOCK APRÈS VENTE -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#DDD6FE"
                    app:strokeWidth="0.7dp"
                    app:cardUseCompatPadding="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F5F3FF"
                        android:orientation="vertical"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🎯 STOCK APRÈS VENTE"
                            android:textColor="#6D28D9"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="sans-serif-medium" />

                        <LinearLayout
                            android:weightSum="2"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_height="wrap_content"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_gravity="center"
                                android:contextClickable="false"
                                app:boxStrokeColor="#6D28D9"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp"
                                app:errorMessage="@string/error_message_empty"
                                app:errorType="empty"
                                android:hint="@string/qt_restante_unit"
                                app:helperText="  "
                                app:expandedHintEnabled="false"
                                android:layout_marginStart="2dp"
                                android:layout_marginEnd="2dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/stockapres"
                                    android:gravity="center"
                                    android:inputType="none"
                                    android:enabled="false"
                                    android:maxLines="1"
                                    android:textStyle="bold"
                                    android:textColor="#0F172A"
                                    android:layout_gravity="center"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    android:backgroundTint="#EDE9FE" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:id="@+id/stockapresLayout_colis"
                                android:layout_height="wrap_content"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_gravity="center"
                                android:contextClickable="false"
                                app:boxStrokeColor="#6D28D9"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp"
                                android:visibility="visible"
                                app:errorMessage="@string/error_message_empty"
                                app:errorType="empty"
                                android:hint="@string/qt_restante_colis"
                                app:helperText="  "
                                app:expandedHintEnabled="false"
                                android:layout_marginStart="2dp"
                                android:layout_marginEnd="2dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/stockapres_colis"
                                    android:gravity="center"
                                    android:inputType="none"
                                    android:enabled="false"
                                    android:maxLines="1"
                                    android:textStyle="bold"
                                    android:textColor="#0F172A"
                                    android:layout_gravity="center"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    android:backgroundTint="#EDE9FE" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- LAST PRICE BAR -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#0F4C81"
                    app:cardUseCompatPadding="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_web_button_primary"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_baseline_payments_24"
                            android:tint="#FFFFFF"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="last_price" />

                        <TextView
                            android:id="@+id/txv_last_price"
                            android:text=""
                            android:textColor="#FFFFFF"
                            android:gravity="center_vertical"
                            android:layout_gravity="center_vertical"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- FOOTER BOUTONS -->
            <LinearLayout
                android:weightSum="2"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.rilixtech.materialfancybutton.MaterialFancyButton
                    android:id="@+id/btn_connect"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:minHeight="52dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_web_button_primary"
                    app:mfb_icon="@drawable/ic_baseline_check_24"
                    app:mfb_textSize="15sp"
