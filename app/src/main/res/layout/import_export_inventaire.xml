<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_web_section_card"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- L1 TOP : Export Inventaire IP -->
        <RelativeLayout
            android:id="@+id/rlt_export_inventaires"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:onClick="onRelativeClick"
            android:background="@drawable/bg_import_row_top_selector"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_web_button_secondary"
                android:gravity="center">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Export inventaires"
                    android:src="@drawable/exportation_24" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="62dp"
                android:layout_marginEnd="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/exportt_inventaire"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Exportation inventaire (Réseaux IP)"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ça vous permet d'exporter tous les inventaires vers le serveur distant"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:lineSpacingExtra="1dp"
                    android:includeFontPadding="false"/>

            </LinearLayout>

        </RelativeLayout>

        <!-- L2 MID : Export Inventaire FTP (gone) -->
        <RelativeLayout
            android:id="@+id/rlt_export_inventaires_ftp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:visibility="gone"
            android:onClick="onRelativeClick"
            android:background="@drawable/bg_import_row_mid_selector"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="-0.8dp">

            <LinearLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_web_button_secondary"
                android:gravity="center">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Export inventaires FTP"
                    android:tint="#1F2937"
                    android:src="@drawable/ic_baseline_storage_24" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="62dp"
                android:layout_marginEnd="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/exportt_inventaire_ftp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Exportation inventaire (Serveur FTP)"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Vous permet d'exporter les bons d'inventaire' vers le serveur FTP"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:lineSpacingExtra="1dp"
                    android:includeFontPadding="false"/>

            </LinearLayout>

        </RelativeLayout>

        <!-- L3 BOTTOM : Inventaires exportés -->
        <RelativeLayout
            android:id="@+id/rlt_exported_inventaires"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:visibility="visible"
            android:onClick="onRelativeClick"
            android:background="@drawable/bg_import_row_bottom_selector"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="-0.8dp">

            <LinearLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_web_button_secondary"
                android:gravity="center">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Inventaires exportés"
                    android:src="@drawable/bon_exporte_24" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="62dp"
                android:layout_marginEnd="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/exportted_inventaire"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bons d'inventaire exportés"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ça vous permet d'afficher les bons d'inventaires exportés avec la possibilité de suppression"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:lineSpacingExtra="1dp"
                    android:includeFontPadding="false"/>

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

</LinearLayout>
