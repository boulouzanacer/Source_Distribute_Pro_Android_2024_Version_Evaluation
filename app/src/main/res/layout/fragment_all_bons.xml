<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    android:fillViewport="true"
    android:padding="12dp"
    android:id="@+id/root_view">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_web_section_card"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:background="@drawable/bg_web_header_blue"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bons"
                android:gravity="center"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#EFF6FF"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="6dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔍 RECHERCHE + FILTRES"
                    android:textColor="#1D4ED8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="3dp"
                    android:paddingStart="2dp" />

                <LinearLayout
                    android:weightSum="5"
                    android:padding="5dp"
                    android:id="@+id/layout_header"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:layout_weight="3.5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:ems="10"
                        android:hint="@string/rechercher_client"
                        android:inputType="text"
                        android:id="@+id/search_field"
                        android:autofillHints=""
                        android:backgroundTint="#DBEAFE"
                        android:padding="10dp"
                        android:background="@drawable/bg_web_section_card"
                        android:layout_marginEnd="4dp" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:layout_weight="0.75"
                        android:id="@+id/scan"
                        android:src="@drawable/ic_codebarre_scan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="#DBEAFE"
                        android:padding="8dp"
                        android:layout_marginEnd="4dp" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:layout_weight="0.75"
                        android:id="@+id/cancel"
                        android:src="@drawable/met_ic_clear"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="#DBEAFE"
                        android:padding="8dp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ECFDF5"
                android:orientation="vertical"
                android:layout_marginTop="2dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="6dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📋 LISTE DES BONS / CLIENTS"
                    android:textColor="#047857"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="3dp"
                    android:paddingStart="2dp" />

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white">

                    <ListView
                        android:id="@+id/list_client"
                        android:layout_width="match_parent"
                        android:layout_height="350dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:divider="@color/gray"
                        android:dividerHeight="1dp" />

                    <ListView
                        android:id="@+id/list_bon"
                        android:layout_width="match_parent"
                        android:layout_height="350dp"
                        android:visibility="gone"
                        android:padding="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:divider="@color/gray"
                        android:dividerHeight="1dp" />

                    <LinearLayout
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:id="@+id/layout_footer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
