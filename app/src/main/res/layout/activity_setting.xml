<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/setting_main"
    android:background="#F1F5F9"
    tools:context="com.safesoft.proapp.distribute.activities.ActivitySetting"
    tools:ignore="NewApi">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/myToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/blue"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        tools:title="Paramètres"
        tools:titleEnabled="false"
        tools:navigationIcon="@drawable/ic_arrow_back_24" />

    <ScrollView
        android:id="@+id/root_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <!-- BT1 : Paramètres Connexion IP -->
            <Button
                android:id="@+id/bt1"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_web_button_primary"
                android:text="@string/parametre_connexion"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/ic_baseline_lan_24"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textAlignment="textStart"
                android:gravity="center|start"
                tools:ignore="RtlHardcoded"/>

            <include layout="@layout/sub_layout_connexion" />

            <!-- BT4 : Paramètres FTP -->
            <Button
                android:id="@+id/bt4"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_web_button_primary"
                android:text="@string/param_tres_serveur_ftp"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/ic_baseline_folder_24"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textAlignment="textStart"
                android:gravity="center|start"
                tools:ignore="RtlHardcoded"/>

            <include layout="@layout/sub_layout_ftp" />

            <!-- BT3 : Paramètres Imprimante -->
            <Button
                android:id="@+id/bt3"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_web_button_primary"
                android:text="@string/param_tres_d_imprimente"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/ic_baseline_print_24"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textAlignment="textStart"
                android:gravity="center|start"
                tools:ignore="RtlHardcoded"/>

            <include layout="@layout/zpref_printer" />

            <include layout="@layout/zpref_scanner" />

            <!-- BT10 : Sauvegarde données -->
            <Button
                android:id="@+id/bt10"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_web_button_primary"
                android:text="@string/sauvegarde_des_donn_es"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/ic_baseline_backup_24"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textAlignment="textStart"
                android:gravity="center|start"
                tools:ignore="RtlHardcoded"/>

            <include layout="@layout/sub_backup" />

            <!-- BT11 : Réinitialisation -->
            <Button
                android:id="@+id/bt11"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_web_button_primary"
                android:text="@string/r_initialisation_des_donn_es"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/ic_baseline_restore_24"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textAlignment="textStart"
                android:gravity="center|start"
                tools:ignore="RtlHardcoded"/>

            <include layout="@layout/sub_reset" />

            <!-- BT12 : Suivi téléphone -->
            <Button
                android:id="@+id/bt12"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_web_button_primary"
                android:text="@string/suivi_de_t_l_phone"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/ic_baseline_track_changes_24"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:visibility="visible"
                android:textAlignment="textStart"
                android:gravity="center|start"
                tools:ignore="RtlHardcoded"/>

            <include layout="@layout/sub_track_phone" />

            <!-- BT2 : Paramètres Divers -->
            <Button
                android:id="@+id/bt2"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_web_button_primary"
                android:text="@string/parametre_divers"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/ic_baseline_tune_24"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textAlignment="textStart"
                android:gravity="center|start"
                tools:ignore="RtlHardcoded"/>

            <include layout="@layout/sub_divers" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
