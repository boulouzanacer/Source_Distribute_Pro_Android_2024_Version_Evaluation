<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:visibility="gone"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_web_section_card"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- L1 TOP : Import Tournées IP -->
        <RelativeLayout
            android:id="@+id/rlt_import_tournees"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:visibility="visible"
            android:onClick="onRelativeClick"
            android:background="@drawable/bg_import_row_top_selector"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_web_button_primary"
                android:gravity="center">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@string/a11y_import_tournees"
                    android:src="@drawable/ic_baseline_route_24" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="62dp"
                android:layout_marginEnd="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/importt_commande"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/l2_importation_tournees_reseaux_ip"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/l2_ca_vous_permet_d_importer_list_des_tourn"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:lineSpacingExtra="1dp"
                    android:includeFontPadding="false"/>

            </LinearLayout>

        </RelativeLayout>

        <!-- L2 MID : Export Tournées IP -->
        <RelativeLayout
            android:id="@+id/rlt_export_tournees"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:visibility="visible"
            android:onClick="onRelativeClick"
            android:background="@drawable/bg_import_row_mid_selector"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="-0.8dp">

            <LinearLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_web_button_gps"
                android:gravity="center">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@string/a11y_export_tournees"
                    android:src="@drawable/ic_baseline_route_24" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="62dp"
                android:layout_marginEnd="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/exportt_commande"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/l2_exportation_tournees_reseaux_ip"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/l2_ca_vous_permet_d_exporter_les_tournees_v"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:lineSpacingExtra="1dp"
                    android:includeFontPadding="false"/>

            </LinearLayout>

        </RelativeLayout>

        <!-- L3 BOTTOM : Tournées exportés -->
        <RelativeLayout
            android:id="@+id/rlt_exported_commandes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:visibility="visible"
            android:onClick="onRelativeClick"
            android:background="@drawable/bg_import_row_bottom_selector"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="-0.8dp">

            <LinearLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_web_button_map"
                android:gravity="center">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@string/a11y_tournees_exportes"
                    android:src="@drawable/ic_baseline_check_24" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="62dp"
                android:layout_marginEnd="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/exportted_commande"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/l2_les_tournees_exportes"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/l2_ca_vous_permet_de_consulter_les_tournees"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:lineSpacingExtra="1dp"
                    android:includeFontPadding="false"/>

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

</LinearLayout>
