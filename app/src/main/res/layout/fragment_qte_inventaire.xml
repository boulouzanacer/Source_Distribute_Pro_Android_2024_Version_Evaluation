<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_web_section_card"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="82dp"
            android:background="@drawable/bg_web_header_blue"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/produit_title"
                android:text="1/2 BENTOUMIA"
                android:textColor="@color/white"
                android:gravity="center"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/message_title"
                android:text=""
                android:textColor="@color/red"
                android:gravity="center"
                android:textSize="12sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#EFF6FF"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📦 STOCK DISPONIBLE"
                    android:textColor="#1D4ED8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="sans-serif-medium" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:contextClickable="false"
                        app:boxStrokeColor="#1D4ED8"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:errorMessage="@string/error_message_empty"
                        app:errorType="empty"
                        android:hint="@string/qt_en_stock_unit"
                        app:expandedHintEnabled="false"
                        app:helperText="  "
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/stockavant"
                            android:gravity="center"
                            android:inputType="none"
                            android:enabled="false"
                            android:textStyle="bold"
                            android:textColor="#0F172A"
                            android:layout_gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:backgroundTint="#DBEAFE" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:id="@+id/stockavantLayout_colis"
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:contextClickable="false"
                        app:boxStrokeColor="#1D4ED8"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:errorMessage="@string/error_message_empty"
                        app:errorType="empty"
                        android:visibility="visible"
                        android:hint="@string/qt_en_stock_colis"
                        app:expandedHintEnabled="false"
                        app:helperText="  "
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/stockavant_colis"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:enabled="false"
                            android:gravity="center"
                            android:inputType="none"
                            android:textColor="#0F172A"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:backgroundTint="#DBEAFE" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/part_3_qteinv_Layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF7ED"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:weightSum="4">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🧮 QUANTITÉS INVENTAIRE"
                    android:textColor="#C2410C"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="sans-serif-medium" />

                <LinearLayout
                    android:weightSum="3"
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_gravity="center"
                        app:boxStrokeColor="#C2410C"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        android:hint="@string/n_colis"
                        app:expandedHintEnabled="false"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/nbrColis"
                            android:gravity="center"
                            android:maxLines="1"
                            android:inputType="numberSigned|numberDecimal"
                            android:textStyle="bold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:backgroundTint="#FFEDD5" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_gravity="center"
                        app:boxStrokeColor="#C2410C"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        android:hint="@string/colis"
                        app:expandedHintEnabled="false"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/colissage"
                            android:gravity="center"
                            android:maxLines="1"
                            android:inputType="numberSigned|numberDecimal"
                            android:textStyle="bold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:backgroundTint="#FFEDD5" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/qteLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_gravity="center"
                        app:boxStrokeColor="#C2410C"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        android:hint="@string/qt"
                        app:expandedHintEnabled="false"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/qte_theorique"
                            android:gravity="center"
                            android:maxLines="1"
                            android:inputType="numberSigned|numberDecimal"
                            android:textStyle="bold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:backgroundTint="#FFEDD5" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F5F3FF"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎯 ÉCART INVENTAIRE"
                    android:textColor="#6D28D9"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="sans-serif-medium" />

                <LinearLayout
                    android:weightSum="2"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:contextClickable="false"
                        app:boxStrokeColor="#6D28D9"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:errorMessage="@string/error_message_empty"
                        app:errorType="empty"
                        android:hint="@string/ecart_unit"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        app:helperText="  "
                        app:expandedHintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/ecart"
                            android:gravity="center"
                            android:inputType="none"
                            android:enabled="false"
                            android:maxLines="1"
                            android:textStyle="bold"
                            android:textColor="#0F172A"
                            android:layout_gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:backgroundTint="#EDE9FE" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:id="@+id/ecartLayout_colis"
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:contextClickable="false"
                        app:boxStrokeColor="#6D28D9"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        android:visibility="visible"
                        app:errorMessage="@string/error_message_empty"
                        app:errorType="empty"
                        android:hint="@string/ecart_colis"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        app:helperText="  "
                        app:expandedHintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/ecart_colis"
                            android:gravity="center"
                            android:inputType="none"
                            android:enabled="false"
                            android:maxLines="1"
                            android:textStyle="bold"
                            android:textColor="#0F172A"
                            android:layout_gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:backgroundTint="#EDE9FE" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:weightSum="2"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="14dp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.rilixtech.materialfancybutton.MaterialFancyButton
                android:id="@+id/btn_connect"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:minHeight="52dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_web_button_primary"
                app:mfb_icon="@drawable/ic_baseline_check_24"
                app:mfb_textSize="16sp"
                app:mfb_radius="12dp"
                app:mfb_text="Valider"
                app:mfb_textColor="#FFFFFF" />

            <com.rilixtech.materialfancybutton.MaterialFancyButton
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:minHeight="52dp"
                android:layout_gravity="right"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_web_button_secondary"
                app:mfb_icon="@drawable/ic_baseline_delete_forever_24"
                app:mfb_textSize="16sp"
                app:mfb_radius="12dp"
                app:mfb_text="Annuler"
                app:mfb_textColor="#0F172A" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
