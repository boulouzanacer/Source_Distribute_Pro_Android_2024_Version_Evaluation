<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/item_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeWidth="0.7dp"
        app:strokeColor="#E2E8F0"
        app:contentPadding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/avatar_fournisseur_container"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.3dp"
                app:strokeColor="#1D4ED8"
                app:cardBackgroundColor="#DBEAFE"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/avatar_frs_initiales"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="FR"
                    android:textColor="#1D4ED8"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/col_info_fournisseur"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                app:layout_constraintStart_toEndOf="@+id/avatar_fournisseur_container"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/sold_fournisseur">

                <TextView
                    android:id="@+id/fournisseur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nom_fournisseur"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Code: "
                        android:textColor="#94A3B8"
                        android:textSize="11.5sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/code_fournisseur_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#475569"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:layout_marginEnd="8dp"/>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/img_pos_fournisseur"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="4dp"
                        android:alpha="0.9"
                        android:src="@drawable/ic_baseline_wrong_location_24"
                        app:tint="#DC2626"
                        android:contentDescription="@null" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/sold_fournisseur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="100dp"
                android:gravity="end|center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:text="+390,000.00"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="@drawable/bg_pill_solde_positif"/>

            <ImageView
                android:id="@+id/imageId"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:contentDescription="@null"/>

            <TextView
                android:id="@+id/achats_fournisseur_cell"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/verser_fournisseur_cell"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/cell_solde_fournisseur"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/achat_fournisseur"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/verser_fournisseur"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tel_fournisseur"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
